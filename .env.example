# Nanoleaf Control Panel environment variables
# Copy this file to .env and fill in your values. Never commit .env.

# OpenWeather API
OPENWEATHER_AUTH_TOKEN=your_openweather_api_key_here
OPENWEATHER_LATITUDE=your_latitude_here
OPENWEATHER_LONGITUDE=your_longitude_here

# Timezone (IANA timezone string, e.g. America/New_York, Europe/London)
# Default: America/Los_Angeles
TIMEZONE=America/Los_Angeles

# Nanoleaf device
NANOLEAF_IP=your_nanoleaf_ip_here
NANOLEAF_AUTH_TOKEN=your_nanoleaf_auth_token_here
